{
  "name": "atsh-ai-v2",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @atsh/public-web",
    "dev:admin": "npm run dev --workspace @atsh/admin",
    "dev:portal": "npm run dev --workspace @atsh/customer-portal",
    "dev:api": "npm run start:dev --workspace @atsh/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" }
}
