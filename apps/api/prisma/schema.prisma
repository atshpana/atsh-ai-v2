generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingType {
  FIXED
  STARTING
  UNIT
  RECURRING
  CUSTOM
}

enum BillingPeriod {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PricingVersionStatus {
  DRAFT
  APPROVED
  ACTIVE
  RETIRED
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  QUOTE_PREPARED
  QUOTE_SENT
  ACCEPTED
  REJECTED
  CONVERTED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  email                    String            @unique @db.VarChar(320)
  displayName              String            @map("display_name") @db.VarChar(160)
  authSubject              String?           @unique @map("auth_subject") @db.VarChar(255)
  status                   UserStatus        @default(INVITED)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerProfile          Customer?
  userRoles                UserRole[]
  grantedRoleAssignments   UserRole[]        @relation("UserRoleGrantor")
  auditEvents              AuditEvent[]      @relation("AuditActor")
  requestEvents            RequestEvent[]    @relation("RequestEventActor")
  createdQuotes            Quote[]           @relation("QuoteCreator")
  quoteAcceptances         QuoteAcceptance[] @relation("QuoteAccepter")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(160)
  module      String           @db.VarChar(100)
  action      String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  scopeType   String?   @map("scope_type") @db.VarChar(80)
  scopeId     String?   @map("scope_id") @db.VarChar(160)
  grantedById String?   @map("granted_by_id") @db.Uuid
  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy   User?     @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([roleId])
  @@map("user_roles")
}

model Customer {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @unique @map("user_id") @db.Uuid
  name        String           @db.VarChar(180)
  email       String           @db.VarChar(320)
  phone       String?          @db.VarChar(40)
  company     String?          @db.VarChar(180)
  countryCode String?          @map("country_code") @db.Char(2)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  requests    ServiceRequest[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model ServiceCategory {
  id          String                @id @default(uuid()) @db.Uuid
  slug        String                @unique @db.VarChar(160)
  status      CatalogStatus         @default(DRAFT)
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations CategoryTranslation[]
  services    Service[]

  @@index([status, sortOrder])
  @@map("service_categories")
}

model CategoryTranslation {
  id          String          @id @default(uuid()) @db.Uuid
  categoryId  String          @map("category_id") @db.Uuid
  locale      String          @db.VarChar(10)
  name        String          @db.VarChar(180)
  description String?         @db.Text
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Service {
  id           String                 @id @default(uuid()) @db.Uuid
  categoryId   String?                @map("category_id") @db.Uuid
  slug         String                 @unique @db.VarChar(180)
  pricingType  PricingType            @map("pricing_type")
  basePrice    Decimal?               @map("base_price") @db.Decimal(14, 2)
  currency     String?                @db.Char(3)
  status       CatalogStatus          @default(DRAFT)
  version      Int                    @default(1)
  sortOrder    Int                    @default(0) @map("sort_order")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  category     ServiceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ServiceTranslation[]
  options      ServiceOption[]
  pricingRules PricingRule[]
  requestItems RequestItemSnapshot[]

  @@index([categoryId, status, sortOrder])
  @@map("services")
}

model ServiceTranslation {
  id                String  @id @default(uuid()) @db.Uuid
  serviceId         String  @map("service_id") @db.Uuid
  locale            String  @db.VarChar(10)
  name              String  @db.VarChar(180)
  shortDescription  String? @map("short_description") @db.VarChar(500)
  body              String? @db.Text
  service           Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@map("service_translations")
}

model ServiceOption {
  id            String           @id @default(uuid()) @db.Uuid
  serviceId     String           @map("service_id") @db.Uuid
  key           String           @db.VarChar(120)
  optionType    String           @map("option_type") @db.VarChar(60)
  priceDelta    Decimal          @default(0) @map("price_delta") @db.Decimal(14, 2)
  billingPeriod BillingPeriod?   @map("billing_period")
  required      Boolean          @default(false)
  status        CatalogStatus    @default(DRAFT)
  sortOrder     Int              @default(0) @map("sort_order")
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  translations  OptionTranslation[]
  snapshots     RequestOptionSnapshot[]

  @@unique([serviceId, key])
  @@index([serviceId, status, sortOrder])
  @@map("service_options")
}

model OptionTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  optionId    String        @map("option_id") @db.Uuid
  locale      String        @db.VarChar(10)
  label       String        @db.VarChar(180)
  description String?       @db.Text
  option      ServiceOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
  @@map("option_translations")
}

model PricingVersion {
  id          String                @id @default(uuid()) @db.Uuid
  version     Int
  status      PricingVersionStatus  @default(DRAFT)
  effectiveFrom DateTime?           @map("effective_from") @db.Timestamptz(6)
  effectiveTo DateTime?             @map("effective_to") @db.Timestamptz(6)
  approvedById String?              @map("approved_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  rules       PricingRule[]
  snapshots   RequestPriceSnapshot[]

  @@unique([version])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("pricing_versions")
}

model PricingRule {
  id               String        @id @default(uuid()) @db.Uuid
  pricingVersionId String        @map("pricing_version_id") @db.Uuid
  serviceId        String?       @map("service_id") @db.Uuid
  priority         Int           @default(100)
  conditions       Json          @db.JsonB
  action           Json          @db.JsonB
  status           CatalogStatus @default(DRAFT)
  pricingVersion   PricingVersion @relation(fields: [pricingVersionId], references: [id], onDelete: Cascade)
  service          Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([pricingVersionId, priority])
  @@index([serviceId])
  @@map("pricing_rules")
}

model ServiceRequest {
  id              String                 @id @default(uuid()) @db.Uuid
  publicReference String                 @unique @map("public_reference") @db.VarChar(40)
  customerId      String?                @map("customer_id") @db.Uuid
  status          RequestStatus          @default(SUBMITTED)
  contactName     String                 @map("contact_name") @db.VarChar(180)
  contactEmail    String                 @map("contact_email") @db.VarChar(320)
  contactPhone    String?                @map("contact_phone") @db.VarChar(40)
  currency        String                 @db.Char(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           RequestItemSnapshot[]
  priceSnapshot   RequestPriceSnapshot?
  events          RequestEvent[]
  quotes          Quote[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("service_requests")
}

model RequestItemSnapshot {
  id                 String                 @id @default(uuid()) @db.Uuid
  requestId          String                 @map("request_id") @db.Uuid
  serviceId          String?                @map("service_id") @db.Uuid
  serviceNameSnapshot String                @map("service_name_snapshot") @db.VarChar(180)
  quantity           Int
  unitPrice          Decimal                @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal                @map("line_total") @db.Decimal(14, 2)
  billingPeriod      BillingPeriod?         @map("billing_period")
  request            ServiceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service            Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  options            RequestOptionSnapshot[]

  @@index([requestId])
  @@map("request_item_snapshots")
}

model RequestOptionSnapshot {
  id                    String              @id @default(uuid()) @db.Uuid
  requestItemSnapshotId String              @map("request_item_snapshot_id") @db.Uuid
  optionId              String?             @map("option_id") @db.Uuid
  optionKeySnapshot     String              @map("option_key_snapshot") @db.VarChar(120)
  labelSnapshot         String              @map("label_snapshot") @db.VarChar(180)
  priceSnapshot         Decimal             @map("price_snapshot") @db.Decimal(14, 2)
  quantity              Int                 @default(1)
  requestItem           RequestItemSnapshot @relation(fields: [requestItemSnapshotId], references: [id], onDelete: Cascade)
  option                ServiceOption?      @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([requestItemSnapshotId])
  @@map("request_option_snapshots")
}

model RequestPriceSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @unique @map("request_id") @db.Uuid
  pricingVersionId String?        @map("pricing_version_id") @db.Uuid
  currency         String         @db.Char(3)
  subtotal         Decimal        @db.Decimal(14, 2)
  discountTotal    Decimal        @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal       Decimal        @map("grand_total") @db.Decimal(14, 2)
  recurringTotal   Decimal        @default(0) @map("recurring_total") @db.Decimal(14, 2)
  calculationJson Json?           @map("calculation_json") @db.JsonB
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pricingVersion   PricingVersion? @relation(fields: [pricingVersionId], references: [id], onDelete: SetNull)

  @@map("request_price_snapshots")
}

model RequestEvent {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  note        String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User?          @relation("RequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("request_events")
}

model Quote {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  version     Int
  status      QuoteStatus    @default(DRAFT)
  currency    String         @db.Char(3)
  subtotal    Decimal        @db.Decimal(14, 2)
  taxTotal    Decimal        @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  validUntil  DateTime?      @map("valid_until") @db.Timestamptz(6)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  acceptance  QuoteAcceptance?

  @@unique([requestId, version])
  @@index([status, validUntil])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  description String  @db.VarChar(500)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(14, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteAcceptance {
  id               String    @id @default(uuid()) @db.Uuid
  quoteId          String    @unique @map("quote_id") @db.Uuid
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  acceptedVersion  Int       @map("accepted_version")
  acceptedAt       DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(6)
  evidence         Json?     @db.JsonB
  quote            Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  acceptedBy       User?     @relation("QuoteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@map("quote_acceptances")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String         @db.VarChar(160)
  entityType  String         @map("entity_type") @db.VarChar(120)
  entityId    String?        @map("entity_id") @db.VarChar(160)
  beforeData  Json?          @map("before_data") @db.JsonB
  afterData   Json?          @map("after_data") @db.JsonB
  requestId   String?        @map("request_id") @db.VarChar(100)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}
