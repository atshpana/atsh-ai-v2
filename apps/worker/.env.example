# Supply real values through your deployment secret manager; never commit secrets.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GITHUB_TOKEN=
ATSH_GITHUB_REPOSITORY=atshpana/atsh-ai-v2
N8N_BASE_URL=
N8N_API_KEY=
N8N_NODE_CATALOG_PATH=
AGENT_POLL_INTERVAL_MS=3000
AGENT_LEASE_MS=120000
AGENT_MAX_TURNS_PER_CLAIM=8
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_DB_POOL_SIZE=4
AGENT_WORKSPACE_ROOT=/var/lib/atsh-agent/jobs

# Leave the sandbox disabled until a dedicated rootless Linux Docker daemon is provisioned.
# Supply the mTLS files as runtime secrets; never mount the Coolify/host Docker socket.
SANDBOX_DOCKER_HOST=
SANDBOX_DOCKER_CA_FILE=
SANDBOX_DOCKER_CERT_FILE=
SANDBOX_DOCKER_KEY_FILE=
SANDBOX_DOCKER_EXPECTED_DAEMON_ID=
SANDBOX_IMAGE=
